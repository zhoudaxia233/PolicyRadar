{
  "name": "policy-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node --experimental-strip-types scripts/build-static.mjs",
    "start": "vite preview --config vite.static.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "data:select": "node --experimental-strip-types scripts/select-export.mjs",
    "data:coverage": "node --experimental-strip-types scripts/check-recent-coverage.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "esbuild": "0.28.0"
  },
  "type": "module"
}
